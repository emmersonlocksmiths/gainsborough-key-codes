rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only your own login can read or change the key codes.
    // Signed-in login allowed to use the app.
    function isNathan() {
      return request.auth != null && request.auth.token.email == 'service@emmersonlocksmiths.com.au';
    }
    match /keycodes/{code} { allow read, write: if isNathan(); }
    match /settings/{doc}  { allow read, write: if isNathan(); }
  }
}
